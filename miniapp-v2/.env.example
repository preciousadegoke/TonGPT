# ──────────────────────────────────────────────────────────────────────────
# TonGPT Mini-App (Vite) — copy to .env.local and fill in.
# Only VITE_*-prefixed vars are exposed to the client. Never put secrets here.
# ──────────────────────────────────────────────────────────────────────────

# Base URL of the FastAPI mini-app backend. Leave blank to use same-origin "/api"
# (recommended in production where the backend serves the built app).
VITE_API_BASE_URL=

# Public HTTPS URL where tonconnect-manifest.json is hosted.
# MUST be reachable by wallets over the public internet (not localhost).
VITE_TONCONNECT_MANIFEST_URL=https://tongpt.loca.lt/tonconnect-manifest.json

# TON network: "mainnet" or "testnet".
VITE_TON_NETWORK=mainnet

# Bot username (no @) — used for referral deep links and Stars invoice fallback.
VITE_BOT_USERNAME=TonGpt_bot

# Dev-only: where `vite dev` proxies /api to. Not used in production builds.
VITE_DEV_API_PROXY=http://localhost:8000
