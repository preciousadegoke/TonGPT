# ── TonGPT Bot — Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in real values.
# Lines starting with # are comments.  Blank values = optional.

# ── Core Bot ────────────────────────────────────────────────────────────────
BOT_TOKEN=your-telegram-bot-token
TELEGRAM_TOKEN=your-telegram-bot-token
BOT_USERNAME=YourBot_username

# ── AI / LLM ───────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-or-v1-...

# ── TON Blockchain ─────────────────────────────────────────────────────────
TON_API_KEY=your-tonapi-key
TONAPI_KEY=your-tonapi-key
PAYMENT_WALLET_ADDRESS=UQCxxx...

# ── Telegram Payments ──────────────────────────────────────────────────────
PAYMENT_TOKEN=1234567890:TEST:xxxxxxxxxxxxxxxx

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Engine API (C# backend) ────────────────────────────────────────────────
ENGINE_API_KEY=your-engine-api-key
ENGINE_URL=http://localhost:5090/api

# ── Security ────────────────────────────────────────────────────────────────
# Must be ≥ 32 chars. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
REFERRAL_SECRET=generate-a-64-char-hex-string-here-using-secrets-module
WEBHOOK_SECRET=generate-another-64-char-hex-string

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins. NEVER use '*' in production.
CORS_ALLOWED_ORIGINS=https://your-app.example.com
API_BASE_URL=https://your-app.example.com/api

# ── Error Reporting ─────────────────────────────────────────────────────────
# Telegram channel ID for error alerts (e.g. -100123456789).
# If not set, errors are logged but not sent to Telegram.
ERROR_CHANNEL_ID=

# ── Logging ─────────────────────────────────────────────────────────────────
# Supported values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# ── Environment ─────────────────────────────────────────────────────────────
# "production" (default) or "development"
# development: allows CORS wildcard, uses console log renderer
ENVIRONMENT=production

# ── Misc ────────────────────────────────────────────────────────────────────
NOTIFICATION_RETENTION_DAYS=30
CONVERSATION_TTL_SECONDS=3600

# ── Database (for C# Engine, if applicable) ─────────────────────────────────
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=TonGPT;Username=postgres;Password=password

# ===== Content Moderation (OpenAI) =====
# Moderation needs a REAL OpenAI key (sk-...), NOT an OpenRouter key (sk-or-...).
# Your OPENAI_API_KEY above is currently an sk-or-... key, so set a dedicated
# OpenAI key here to enable moderation (GPT still uses OPENROUTER_API_KEY).
OPENAI_MODERATION_API_KEY=
MODERATION_ENABLED=true
# Fail CLOSED for genuine errors in the active moderation path.
MODERATION_FAIL_OPEN=false
# Mode: auto = OpenAI if sk- key set, else OpenRouter LLM classifier, else
# local regex pre-filter. A missing key selects a fallback, never dead chat.
MODERATION_MODE=auto
# MODERATION_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT=8
# Optional: only these flagged categories block (default: block ANY flagged)
# MODERATION_BLOCK_CATEGORIES=hate,harassment,self-harm,sexual,sexual/minors,violence


# ===== TON Data Service (/info, /whale) =====
TONAPI_KEY=
TONAPI_BASE_URL=https://tonapi.io/v2
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TON_ID=the-open-network
TON_PRICE_CACHE_TTL=60
TON_WHALE_CACHE_TTL=300
TON_STALE_CACHE_TTL=86400
TON_HTTP_TIMEOUT=10
TON_HTTP_MAX_RETRIES=3
TON_HTTP_BACKOFF_BASE=0.5
TON_BREAKER_THRESHOLD=4
TON_BREAKER_COOLDOWN=30
WHALE_MIN_TON=10000
WHALE_MAX_ADDRESSES=8
WHALE_WATCH_ADDRESSES=
# TON_KNOWN_JETTONS={"USDT":"EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs"}


# ===== DexScreener Integration (/info, /trending) =====
DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_CHAIN=ton
DEX_INFO_CACHE_TTL=45
DEX_TRENDING_CACHE_TTL=60
DEX_STALE_CACHE_TTL=86400
DEX_HTTP_TIMEOUT=10
DEX_HTTP_MAX_RETRIES=2
DEX_BREAKER_THRESHOLD=4
DEX_BREAKER_COOLDOWN=30
# Safety heuristic thresholds
DEX_LIQ_VERY_LOW_USD=5000
DEX_LIQ_LOW_USD=25000
DEX_HOLDER_WARN_PCT=20
DEX_HOLDER_DANGER_PCT=50
# Trending: comma-separated TON jetton addresses + a chain search query
TON_TRENDING_TOKENS=
DEX_TRENDING_SEARCH=ton


# ============================================================================
# RATE LIMITING (core/rate_limiter.py) — canonical, tier-aware, fail-safe
# ============================================================================
# Master switch. Set to false ONLY for emergencies/debugging.
RATE_LIMIT_ENABLED=true

# Conservative ceiling applied PER USER when Redis is unavailable. Fail-safe,
# not fail-open: an outage throttles instead of handing out unlimited GPT calls.
RATE_LIMIT_FALLBACK_PER_MIN=5

# How long (seconds) a user's resolved subscription tier is cached in-process,
# to avoid hitting the C# Engine on every message.
RATE_LIMIT_TIER_CACHE_TTL=60

# Per-tier ceilings: per minute / per hour / per day.
# per_day = -1 means UNLIMITED. Daily values mirror the subscription system's
# queries_per_day (handlers/pay.py): 100 / 500 / 1000 / unlimited.
RATE_LIMIT_FREE_PER_MIN=3
RATE_LIMIT_FREE_PER_HOUR=15
RATE_LIMIT_FREE_PER_DAY=25

RATE_LIMIT_STARTER_PER_MIN=10
RATE_LIMIT_STARTER_PER_HOUR=100
RATE_LIMIT_STARTER_PER_DAY=100

RATE_LIMIT_PRO_PER_MIN=20
RATE_LIMIT_PRO_PER_HOUR=300
RATE_LIMIT_PRO_PER_DAY=500

RATE_LIMIT_PRO_PLUS_PER_MIN=30
RATE_LIMIT_PRO_PLUS_PER_HOUR=600
RATE_LIMIT_PRO_PLUS_PER_DAY=1000

RATE_LIMIT_ELITE_PER_MIN=60
RATE_LIMIT_ELITE_PER_HOUR=2000
RATE_LIMIT_ELITE_PER_DAY=-1

# ============================================================================
# PAYMENT ACTIVATION RELIABILITY (services/activation_queue.py)
# ============================================================================
# Postgres (via the C# Engine's POST /api/Payment/complete) is the SINGLE source
# of truth for payment idempotency + subscription activation. If the Engine is
# briefly unreachable when a payment succeeds, the activation is written to this
# durable on-disk queue and retried by a background loop — independent of Redis.
ACTIVATION_QUEUE_FILE=data/pending_activations.jsonl
# How often (seconds) the reconciliation loop drains the pending queue.
ACTIVATION_RETRY_INTERVAL=60
# After this many failed retries for one item, escalate to the error channel.
ACTIVATION_ALERT_AFTER=10

# ============================================================================
# TON ON-CHAIN PAYMENTS (services/ton_payments.py)
# ============================================================================
# Live TON payments are DIRECT TRANSFERS to one monitored wallet, tagged with a
# unique memo (TGP1-<userid>-<plan>-<nonce>). A background monitor matches the
# transfer and activates the subscription via the atomic, idempotent
# Payment/complete endpoint. No custom smart contract is required.
#
# SAFETY: keep this DISABLED until you have tested end-to-end on TESTNET.
TON_PAYMENTS_ENABLED=false
# testnet | mainnet  (controls which TONAPI base + which warnings are shown)
TON_NETWORK=testnet
# The single wallet users send TON to (user-friendly EQ../UQ.. address).
MONITORED_WALLET_ADDRESS=
# Accept payments >= (price * (1 - tolerance)). 0.02 = allow 2% under for fees.
TON_PAYMENT_TOLERANCE=0.02
# How often (seconds) to poll the monitored wallet for incoming transfers.
TON_MONITOR_INTERVAL=30
# How long a shown TON quote/memo stays "pending" for status display (minutes).
TON_PAYMENT_EXPIRY_MIN=60
# Optional TONAPI key (higher rate limits). TONAPI_BASE_URL overrides the base.
# TONAPI_KEY=

# --- Async TON service (services/ton_api_service.py) extra knobs ---
TON_HTTP_BACKOFF_CAP=8
TON_USER_QUOTA_PER_HOUR=100
